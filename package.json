{
  "name": "ai-first-web-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "verify:agent-readability": "node scripts/verify-agent-readability.mjs",
    "test:watch": "vitest",
    "audit:agentic": "node scripts/audit-agentic.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.2",
    "jsdom": "^25.0.0",
    "lighthouse": "^13.5.0",
    "turndown": "^7.2.4",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
